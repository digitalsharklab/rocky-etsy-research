# Wymagane: klucz API Anthropic (https://platform.claude.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Opcjonalne: model Claude (domyślnie claude-opus-5).
# Tańsza alternatywa: claude-haiku-4-5
# CLAUDE_MODEL=claude-opus-5

# Opcjonalne: port lokalnego serwera (domyślnie 3000)
# PORT=3000

# Opcjonalne: ogranicz CORS do konkretnej domeny w produkcji
# ALLOWED_ORIGIN=https://twoja-aplikacja.vercel.app

# Opcjonalne: limit zapytań na minutę na IP (domyślnie 20)
# RATE_LIMIT_PER_MINUTE=20
